# Copy to .env.local and adjust. Every variable here is optional for local development.

# Host of the room server, without https:// or a trailing slash.
# Defaults to localhost:1999, which is where `npm run dev` starts it.
# In production, set it to the Cloudflare Worker host, e.g.
# planning-poker.square-poetry-83d1.workers.dev
# NEXT_PUBLIC_* values are baked in at build time, so redeploy after changing it.
NEXT_PUBLIC_PARTYKIT_HOST=localhost:1999
