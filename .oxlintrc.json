{
  "extends": ["./vendor/base/tooling/oxlintrc.base.json"],
  "jsPlugins": ["@shadcn/lint"],
  "ignorePatterns": ["**/dist", "**/.wrangler", "room-server/worker-configuration.d.ts", "vendor"],
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@ui-sdk/**"],
            "message": "Import controls from src/components/ui. Only that folder may import ui-sdk."
          }
        ]
      }
    ],
    "shadcn/no-unknown-classes": "error",
    "shadcn/no-raw-colors": "error",
    "shadcn/no-arbitrary-values": "error",
    "shadcn/no-inline-styles": "error"
  },
  "overrides": [
    {
      "files": ["src/components/ui/**"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["test/bun-setup.ts"],
      "rules": {
        "bun/no-side-effects-on-import": "off",
        "vitest/require-hook": "off",
        "vitest/require-top-level-describe": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "typescript/no-non-null-assertion": "off"
      }
    }
  ]
}
