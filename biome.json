{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": { "noUnusedVariables": "error", "noUnusedImports": "error" }
    }
  },
  "css": { "parser": { "tailwindDirectives": true } },
  "files": {
    "includes": [
      "**",
      "!**/.next",
      "!**/node_modules",
      "!**/.wrangler",
      "!room-server/worker-configuration.d.ts"
    ]
  }
}
