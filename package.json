{
  "name": "planning-poker",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"next dev\" \"wrangler dev\"",
    "dev:next": "next dev",
    "dev:party": "wrangler dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit --incremental false && tsc -p party",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types party/worker-configuration.d.ts"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "nanoid": "^6.0.2",
    "next": "16.4.5",
    "partyserver": "^0.5.10",
    "partysocket": "^1.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.5",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.3.4",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  }
}
