{
  "name": "planning-poker",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "prepare": "node vendor/sm-core/tooling/hooks/install.mjs",
    "dev": "concurrently \"vite\" \"wrangler dev\"",
    "dev:app": "vite",
    "dev:room-server": "wrangler dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && node vendor/sm-core/verify.mjs",
    "typecheck": "bun check --no-script && bun check --no-script -p room-server",
    "typecheck:tsc": "tsc --noEmit && tsc -p room-server",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types room-server/worker-configuration.d.ts"
  },
  "dependencies": {
    "@fontsource/geist": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "2.1.0",
    "nanoid": "^6.0.2",
    "partyserver": "^0.5.10",
    "partysocket": "^1.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.0"
  }
}
