{
  "name": "planning-poker",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "prepare": "bun vendor/sm-core/tooling/hooks/install.mjs",
    "dev": "bun --bun x concurrently \"bun --bun x vite\" \"bun --bun x wrangler dev\"",
    "dev:app": "bun --bun x vite",
    "dev:room-server": "bun --bun x wrangler dev",
    "build": "bun --bun x vite build",
    "preview": "bun --bun x vite preview",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build && node vendor/sm-core/verify.mjs",
    "typecheck": "bun check --no-script && bun check --no-script -p room-server",
    "typecheck:tsc": "bun --bun x tsc --noEmit && bun --bun x tsc -p room-server",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun --bun x vitest run",
    "test:watch": "bun --bun x vitest",
    "cf-typegen": "bun --bun x wrangler types room-server/worker-configuration.d.ts"
  },
  "dependencies": {
    "@fontsource/geist": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "@ui-sdk/core": "0.1.0-beta.7",
    "@ui-sdk/react": "0.1.0-beta.7",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "2.1.0",
    "nanoid": "^6.0.2",
    "partyserver": "^0.5.10",
    "partysocket": "^1.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "4.14.1",
    "concurrently": "^10.0.7",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.164.0"
  }
}
