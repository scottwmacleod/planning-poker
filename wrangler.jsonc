{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "planning-poker",
  "main": "room-server/server.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "Main", "class_name": "PokerRoom" }]
  },
  "dev": { "port": 1999 },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PokerRoom"] }],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "destinations": ["posthog-logs"],
      "persist": false
    }
  }
}
